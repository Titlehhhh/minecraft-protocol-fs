<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>

        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <OutputType>Exe</OutputType>
        <UserSecretsId>12d88f7f-2301-45fc-a3d8-b9333441a1e3</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5"/>
        <PackageReference Include="ModelContextProtocol" Version="1.1.0"/>
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.1.0"/>
        <PackageReference Include="ToonEncoder" Version="2.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\McProtoFacts.Protocol\McProtoFacts.Protocol.csproj"/>
        <ProjectReference Include="..\ProtoCore\ProtoCore.csproj"/>
    </ItemGroup>

    <Target Name="BuildClientApp" BeforeTargets="Build" Condition="Exists('ClientApp/package.json') and '$(BuildClientApp)' != 'false'">
        <Exec Command="npm install" WorkingDirectory="ClientApp" />
        <Exec Command="npm run build" WorkingDirectory="ClientApp" />
    </Target>

</Project>
