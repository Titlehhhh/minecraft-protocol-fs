<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <RootNamespace>McProtocol.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="PacketCountTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- The wiki reference data (this test's expectations) and the packet manifest
             it checks. Both are read at run time, so both are copied next to the test. -->
        <Content Include="wiki-packet-counts.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="../../minecraft-protocol-fs/Spec/protocol-ids.json" Link="protocol-ids.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../minecraft-protocol-fs/minecraft-protocol-fs.fsproj" />
    </ItemGroup>

</Project>
