<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <RootNamespace>McProtoNet</RootNamespace>
    </PropertyGroup>

    <!-- Generated protocol types, linked from the F# generator's output (the `gen` run).
         Specs that reference not-yet-modelled C# types (Particle, Slot, unions, ...) are
         excluded until those types land. -->
    <ItemGroup>
        <Compile Include="..\..\generated-csharp\**\*.cs"
                 Exclude="..\..\generated-csharp\Types\EntityMetadataEntry.cs;
                          ..\..\generated-csharp\Packets\Play\Clientbound\TeamsPacket.cs;
                          ..\..\generated-csharp\Packets\Play\Clientbound\ExplosionPacket.cs;
                          ..\..\generated-csharp\Packets\Play\Clientbound\EntityMetadataPacket.cs;
                          ..\..\generated-csharp\Packets\Play\Clientbound\MapPacket.cs;
                          ..\..\generated-csharp\Packets\Play\Clientbound\RespawnPacket.cs;
                          ..\..\generated-csharp\Packets\Play\Serverbound\WindowClickPacket.cs;
                          ..\..\generated-csharp\Packets\Configuration\Clientbound\DisconnectPacket.cs"
                 Link="Generated\%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
