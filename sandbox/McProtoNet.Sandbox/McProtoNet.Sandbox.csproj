<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <RootNamespace>McProtoNet</RootNamespace>
    </PropertyGroup>

    <!-- Generated protocol types, linked from the F# generator's output (the `gen` run).
         What stays excluded references a C# type the sandbox has no model for (Slot, Particle,
         the registry variants) or a still-stubbed wire shape. Unions compile here now, so
         TeamAction and its packet are in; EntityMetadataValue is not, because its arms read
         Slot and Particle. Its three risky shapes — keyword-named cases, a case carrying a
         same-named type, a case carrying an array of one — are compiled and round-tripped
         through Unions/UnionShapeProbe.cs until those types exist. -->
    <ItemGroup>
        <Compile Include="..\..\generated-csharp\**\*.cs"
                 Exclude="..\..\generated-csharp\Flow\**\*.cs;
                          ..\..\generated-csharp\Unions\EntityMetadataValue.cs;
                          ..\..\generated-csharp\Types\EntityMetadataEntry.cs;
                          ..\..\generated-csharp\Types\ExplosionParticleEntry.cs;
                          ..\..\generated-csharp\Types\ExplosionParticleInfo.cs;
                          ..\..\generated-csharp\Packets\Play\Clientbound\ExplosionPacket.cs;
                          ..\..\generated-csharp\Packets\Play\Clientbound\EntityMetadataPacket.cs;
                          ..\..\generated-csharp\Packets\Play\Clientbound\MapPacket.cs;
                          ..\..\generated-csharp\Packets\Play\Clientbound\RespawnPacket.cs;
                          ..\..\generated-csharp\Packets\Play\Clientbound\LoginPacket.cs;
                          ..\..\generated-csharp\Packets\Play\Serverbound\WindowClickPacket.cs"
                 Link="Generated\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Dunet" Version="1.16.2" />
    </ItemGroup>

</Project>
