<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>McProtocol</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- DSL: generic algebra, builders, helpers, printer -->
        <Compile Include="Dsl\Ast.fs" />
        <Compile Include="Dsl\Builders.fs" />
        <Compile Include="Dsl\Helpers.fs" />
        <Compile Include="Dsl\Printer.fs" />

        <!-- Codegen: abstract language target + backends (depends only on the DSL) -->
        <Compile Include="Codegen\PacketIds.fs" />
        <Compile Include="Codegen\Registry.fs" />
        <Compile Include="Codegen\Target.fs" />
        <Compile Include="Codegen\Coverage.fs" />
        <Compile Include="Codegen\Generator.fs" />
        <Compile Include="Codegen\CSharpSurface.fs" />

        <!-- C# backend, split by dependency layer: text helpers -> Roslyn structure ->
             wire statements -> layout bodies -> per-spec renderers -> the target that binds
             them. `CSharpTarget.fs` keeps the public entry point (`CSharp.target`). -->
        <Compile Include="Codegen\CSharp\Text.fs" />
        <Compile Include="Codegen\CSharp\Structure.fs" />
        <Compile Include="Codegen\CSharp\Statements.fs" />
        <Compile Include="Codegen\CSharp\Bodies.fs" />
        <Compile Include="Codegen\CSharp\Renderers\NamedTypes.fs" />
        <Compile Include="Codegen\CSharp\Renderers\PacketParts.fs" />
        <Compile Include="Codegen\CSharp\Renderers\PacketLayers.fs" />
        <Compile Include="Codegen\CSharp\Renderers\Bitflags.fs" />
        <Compile Include="Codegen\CSharp\Renderers\Enums.fs" />
        <Compile Include="Codegen\CSharp\Renderers\Unions.fs" />
        <Compile Include="Codegen\CSharp\Renderers\Aggregates.fs" />
        <Compile Include="Codegen\CSharp\CSharpTarget.fs" />

        <!-- Spec: WireAliases first (shared helper bindings), then every spec file auto-globbed.
             Protocol.fs indexes all specs by reflection, so a new type/union/packet needs no edit
             here or there — just drop a file under Spec/. (Specs reference each other only by
             string name, so compile order among them does not matter.) -->
        <Compile Include="Spec\WireAliases.fs" />
        <Compile Include="Spec\**\*.fs" Exclude="Spec\WireAliases.fs;Spec\Protocol.fs" />
        <Compile Include="Spec\Protocol.fs" />

        <!-- Entry point -->
        <Compile Include="Program.fs" />
    </ItemGroup>

    <!-- Packet id manifest generated by scripts\generate-ids-manifest.ps1 from McProtoFacts;
         copied next to the built exe so Program.fs can resolve it at run time. -->
    <ItemGroup>
        <Content Include="Spec\protocol-ids.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Show the generated C# output in the IDE (not compiled by this F# project).
         The `gen` run writes these into ..\generated-csharp\. -->
    <ItemGroup>
        <None Include="..\generated-csharp\**\*.cs" Link="generated-csharp\%(RecursiveDir)%(Filename)%(Extension)" Visible="true" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    </ItemGroup>

</Project>
